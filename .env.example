# Bu faylni ".env" nomi bilan nusxalang va haqiqiy ma'lumotlarni kiriting:
#   cp .env.example .env
#
# BotFather'dan /revoke orqali OLINGAN YANGI tokenni shu yerga yozing:
BOT_TOKEN=SIZNING_YANGI_TOKENINGIZ

# MongoDB Atlas'dan olingan ulanish satri (connection string).
# <db_password> o'rniga haqiqiy parolingizni qo'ying:
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?appName=Cluster0

